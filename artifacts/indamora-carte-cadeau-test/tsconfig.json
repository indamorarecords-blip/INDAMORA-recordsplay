{
  "extends": "../../tsconfig.base.json",
  "include": [
    "src/App.tsx",
    "src/api/**/*.ts",
    "src/db/**/*.ts",
    "src/generated/**/*.ts",
    "src/main.tsx",
    "src/server.ts",
    "scripts/**/*.ts",
    "vite.config.ts"
  ],
  "exclude": ["node_modules", "build", "dist", "**/*.test.ts"],
  "compilerOptions": {
    "noEmit": true,
    "jsx": "preserve",
    "lib": ["esnext", "dom", "dom.iterable"],
    "resolveJsonModule": true,
    "allowImportingTsExtensions": true,
    "moduleResolution": "bundler",
    "types": ["node", "vite/client"],
    "paths": {
      "@/*": ["./src/*"]
    }
  },
  "references": []
}
